    assert result["success"] is True
    

def test_read_resume_tool_success():
    result = read_resume_tool.invoke({"resume_path": "fdata/p004_resume_screening_crew_dataset/resumes/candidate_001_rohan_mehta"})
    assert result["success"] is True

